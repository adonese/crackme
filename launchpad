#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  ./launchpad wine [path]       Run a Windows crackme through Wine
  ./launchpad ghidra [file]     Start Ghidra, or import/open one executable
  ./launchpad install-ghidra     Install a global ghidra wrapper in ~/.local/bin
  ./launchpad view [port]       Browse local Markdown/HTML/practice files
  ./launchpad map               Print the repo navigation map
  ./launchpad inventory [cmd]   Write or verify the tracked-file hash manifest
  ./launchpad list              List likely challenge binaries

Examples:
  ./launchpad map
  ./launchpad wine
  ./launchpad wine crackmes/crackme_4_psyr3n/PIDXploit.exe
  ./launchpad ghidra crackmes/crackme_1_TLOD/EasyCrackMe.exe
  ./launchpad install-ghidra
  ./launchpad view
  ./launchpad inventory verify
USAGE
}

cmd="${1:-}"
case "$cmd" in
  wine)
    shift
    exec "$ROOT/launchpads/wine.sh" "$@"
    ;;
  ghidra)
    shift
    exec "$ROOT/launchpads/ghidra.sh" "$@"
    ;;
  install-ghidra)
    mkdir -p "$HOME/.local/bin"
    wrapper="$HOME/.local/bin/ghidra"
    {
      printf '%s\n' '#!/usr/bin/env bash'
      printf 'exec %q ghidra "$@"\n' "$ROOT/launchpad"
    } > "$wrapper"
    chmod +x "$wrapper"
    echo "Installed $wrapper"
    if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
      echo "Add $HOME/.local/bin to PATH to use: ghidra <file>" >&2
    fi
    ;;
  view)
    shift
    if ! command -v uv >/dev/null 2>&1; then
      echo "uv is required for ./launchpad view. Install it from https://docs.astral.sh/uv/." >&2
      exit 1
    fi
    if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
      port="$1"
      shift
      exec uv run --script "$ROOT/tools/repo_viewer.py" --port "$port" "$@"
    fi
    exec uv run --script "$ROOT/tools/repo_viewer.py" "$@"
    ;;
  map)
    sed -n '1,220p' "$ROOT/docs/MAP.md"
    ;;
  inventory)
    shift
    if ! command -v uv >/dev/null 2>&1; then
      echo "uv is required for ./launchpad inventory. Install it from https://docs.astral.sh/uv/." >&2
      exit 1
    fi
    exec uv run --script "$ROOT/tools/repo_inventory.py" "$@"
    ;;
  list)
    find "$ROOT/crackmes" "$ROOT/practice" -type f \
      \( -iname '*.exe' -o -iname '*.scr' -o -iname '*.dll' -o -iname '*.bin' -o -iname '*.flp' \) \
      -print | sed "s#^$ROOT/##" | sort
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
