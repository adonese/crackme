#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  ./launchpad wine [path]       Run a Windows crackme through Wine
  ./launchpad ghidra [args...]  Start Ghidra
  ./launchpad view [port]       Browse local Markdown/HTML/practice files
  ./launchpad list              List likely challenge binaries

Examples:
  ./launchpad wine
  ./launchpad wine crackmes/crackme_4_psyr3n/PIDXploit.exe
  ./launchpad ghidra
  ./launchpad view
USAGE
}

cmd="${1:-}"
case "$cmd" in
  wine)
    shift
    exec "$ROOT/launchpads/wine.sh" "$@"
    ;;
  ghidra)
    shift
    exec "$ROOT/launchpads/ghidra.sh" "$@"
    ;;
  view)
    shift
    if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
      port="$1"
      shift
      exec python3 "$ROOT/tools/repo_viewer.py" --port "$port" "$@"
    fi
    exec python3 "$ROOT/tools/repo_viewer.py" "$@"
    ;;
  list)
    find "$ROOT/crackmes" "$ROOT/practice" -type f \
      \( -iname '*.exe' -o -iname '*.scr' -o -iname '*.dll' -o -iname '*.bin' -o -iname '*.flp' \) \
      -print | sed "s#^$ROOT/##" | sort
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
